<Window x:Class="SesPlus.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Volume + · Volume Booster" Icon="pack://application:,,,/Assets/volumeplus.ico" Width="1040" Height="860" MinWidth="950" MinHeight="730" Background="#111823" FontFamily="Segoe UI" Foreground="#F0F3F8" WindowStartupLocation="CenterScreen">
  <Grid Margin="30,24,30,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="28" /><RowDefinition Height="*" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="42" Height="42" Background="#D3F585" CornerRadius="13" Margin="0,0,13,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="4" Height="10" CornerRadius="2" Background="#172019" Margin="2" /><Border Width="4" Height="22" CornerRadius="2" Background="#172019" Margin="2" /><Border Width="4" Height="15" CornerRadius="2" Background="#172019" Margin="2" /></StackPanel></Border>
        <StackPanel><Image Width="154" Height="44" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Volume +"><Image.Source><CroppedBitmap SourceRect="60,480,1140,320"><CroppedBitmap.Source><BitmapImage UriSource="pack://application:,,,/Assets/volumeplus-icon.png" /></CroppedBitmap.Source></CroppedBitmap></Image.Source></Image><TextBlock x:Name="BrandCaption" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="1,2,0,0" /></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="LanguageLabel" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" /><ComboBox x:Name="LanguageBox" Width="170" SelectionChanged="LanguageChanged" DisplayMemberPath="NativeName" SelectedValuePath="Code" /></StackPanel>
    </Grid>
    <ScrollViewer x:Name="BodyScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,2">
    <Grid x:Name="AudioLayout">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border x:Name="GainCard" Background="#1B2432" BorderBrush="#303C4C" BorderThickness="1" CornerRadius="18" Padding="28,24">
          <StackPanel>
            <Grid><TextBlock x:Name="GainHeading" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" /><Border HorizontalAlignment="Right" Background="#293731" Padding="9,4" CornerRadius="6"><TextBlock x:Name="GainRangeBadge" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" /></Border></Grid>
            <TextBlock x:Name="HeroTitle" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,0" />
            <TextBlock x:Name="HeroSubtitle" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" />
            <Grid Margin="0,22,0,18" MinHeight="102"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="PercentDisplay" Text="100%" FontSize="76" FontWeight="Light" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,15"><TextBlock x:Name="DbDisplay" Text="+0.00 dB" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock x:Name="DbCaption" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right" /></StackPanel></Grid>
            <Slider x:Name="GainSlider" Minimum="100" Maximum="200" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10" ValueChanged="GainChanged" PreviewMouseLeftButtonDown="NormalSliderEngaged" PreviewKeyDown="NormalSliderKeyPressed" />
            <Grid Margin="0,3,0,18"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="100" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Grid.Column="1" Text="125" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" Text="150" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" /><TextBlock Grid.Column="3" Text="175" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" /><TextBlock Grid.Column="4" Text="200" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" /></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><UniformGrid Columns="4" Margin="-3,0"><Button x:Name="NormalPreset" Tag="100" Click="PresetClicked" Margin="3" Padding="5,10" /><Button x:Name="Preset125" Tag="125" Click="PresetClicked" Margin="3" Padding="5,10" /><Button x:Name="Preset150" Tag="150" Click="PresetClicked" Margin="3" Padding="5,10" /><Button x:Name="Preset200" Tag="200" Click="PresetClicked" Margin="3" Padding="5,10" /></UniformGrid><Button Grid.Column="2" x:Name="CustomPercentageButton" Click="CustomPercentageClicked" Padding="12,10" FontSize="12" /></Grid>
            <TextBlock x:Name="CustomLevelHint" TextWrapping="Wrap" FontSize="11" Foreground="#F4C978" Visibility="Collapsed" Margin="0,10,0,0" />
            <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="ApplyButton" Click="ApplyClicked" Background="{StaticResource AccentBrush}" Foreground="#172019" BorderThickness="0" Padding="18,13" /><Button Grid.Column="2" x:Name="ResetButton" Click="ResetClicked" Padding="16,13" /></Grid>
            <TextBlock x:Name="AutoResetHint" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
          </StackPanel>
        </Border>
        <Border x:Name="StatusCard" Grid.Row="2" Background="#181F2B" BorderBrush="#2C3748" BorderThickness="1" CornerRadius="14" Padding="20,16"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#F4C978" Width="7" Height="7" Margin="0,0,9,0" /><TextBlock x:Name="StatusHeading" FontSize="13" FontWeight="SemiBold" /></StackPanel><TextBlock x:Name="StatusDescription" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="16,8,0,0" /><Button x:Name="DetailsButton" Click="DetailsClicked" Visibility="Collapsed" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" Padding="0,9,0,0" Margin="16,0,0,0" FontSize="11" /></StackPanel></Border>
      </Grid>
      <Border x:Name="OutputCard" Grid.Column="2" Background="#181F2B" BorderBrush="#2C3748" BorderThickness="1" CornerRadius="18" Padding="22,24">
        <StackPanel>
          <TextBlock x:Name="OutputHeading" FontSize="17" FontWeight="SemiBold" />
          <TextBlock x:Name="DeviceCaption" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,19,0,8" />
          <ComboBox x:Name="DeviceBox" SelectionChanged="DeviceChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <TextBlock x:Name="DeviceHelp" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
          <Border Height="1" Background="#303A49" Margin="0,22,0,20" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Equalizer APO" FontWeight="SemiBold" FontSize="13" /><TextBlock Grid.Column="1" x:Name="EngineStatus" Foreground="#F4C978" FontSize="11" VerticalAlignment="Center" /></Grid>
          <TextBlock x:Name="SetupIntro" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,15" />
          <TextBlock x:Name="SetupStepOne" TextWrapping="Wrap" FontSize="12" />
          <Button x:Name="DownloadButton" Click="DownloadClicked" Margin="0,10,0,15" Padding="10,10" />
          <TextBlock x:Name="SetupStepTwo" TextWrapping="Wrap" FontSize="12" />
          <Button x:Name="DeviceSetupButton" Click="DeviceSetupClicked" Margin="0,10,0,15" Padding="10,10" />
          <TextBlock x:Name="SetupStepThree" TextWrapping="Wrap" FontSize="12" />
          <Button x:Name="RefreshButton" Click="RefreshClicked" Margin="0,10,0,0" Padding="10,10" />
          <Button x:Name="AdminButton" Click="AdminClicked" Visibility="Collapsed" Margin="0,12,0,0" Padding="10,10" />
          <Button x:Name="DisconnectButton" Click="DisconnectClicked" Margin="0,16,0,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" Padding="4,5" FontSize="11" />
        </StackPanel>
      </Border>
    </Grid>
    </ScrollViewer>
    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="FooterHint" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" /><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="LicenseButton" Click="LicenseClicked" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" Padding="4,0" FontSize="11" /><TextBlock Text="v1.2.4" Foreground="#627088" FontSize="11" Margin="12,0,0,0" /></StackPanel></Grid>
  </Grid>
</Window>
